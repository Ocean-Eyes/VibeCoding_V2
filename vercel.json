{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/katame-waza/kansetsu-waza/ude-garami",
      "destination": "/practice.html"
    },
    {
      "source": "/katame-waza/osaekomi-waza/kesa-gatame",
      "destination": "/practice.html"
    },
    {
      "source": "/phone-camera",
      "destination": "/phone-camera.html"
    },
    {
      "source": "/basics",
      "destination": "/index.html"
    },
    {
      "source": "/basics/belt",
      "destination": "/practice.html"
    },
    {
      "source": "/basics/hindu-push-up",
      "destination": "/practice.html"
    },
    {
      "source": "/katame-waza",
      "destination": "/index.html"
    },
    {
      "source": "/katame-waza/shime-waza",
      "destination": "/index.html"
    },
    {
      "source": "/katame-waza/kansetsu-waza",
      "destination": "/index.html"
    },
    {
      "source": "/katame-waza/osaekomi-waza",
      "destination": "/index.html"
    },
    {
      "source": "/katame-waza/shime-waza/nami-juji-jime",
      "destination": "/practice.html"
    },
    {
      "source": "/katame-waza/shime-waza/gyaku-juji-jime",
      "destination": "/practice.html"
    },
    {
      "source": "/katame-waza/shime-waza/kata-juji-jime",
      "destination": "/practice.html"
    },
    {
      "source": "/throws",
      "destination": "/index.html"
    },
    {
      "source": "/throws/o-soto-gari",
      "destination": "/practice.html"
    },
    {
      "source": "/throws/o-uchi-gari",
      "destination": "/practice.html"
    },
    {
      "source": "/throws/ippon-seoi-nage",
      "destination": "/practice.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
